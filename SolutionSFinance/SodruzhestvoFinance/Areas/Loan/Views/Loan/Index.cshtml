@{
    ViewData["Title"] = "Список займов";
    Layout = "_Layout";
}

@model IEnumerable<SodruzhestvoFinance.Areas.Loan.Models.Loan>


<h1>Список займов</h1>

@using (Html.BeginForm("LoanCreationPage", "Loan", FormMethod.Get))
{
    <button type="submit" class="btn btn-sm btn-success mr-3">Оформить новый заём</button>
}

<table class="table">
    <thead>
        <tr>
            <th>
                №
            </th>
            <th>
                Пайщик
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoanAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterestRate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoanTerm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IssueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CurrentBalance)
            </th>
            <th>
                Статус
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.LoanId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Employee.LastName) @Html.DisplayFor(modelItem => item.Employee.FirstName) @Html.DisplayFor(modelItem => item.Employee.MiddleName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LoanAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InterestRate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LoanTerm)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IssueDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CurrentBalance)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LoanStatus.StatusName)
                </td>
                <td>
                    <div class="d-flex">
                        <div class="mx-2">
                            @using (Html.BeginForm("Edit", "Loan", FormMethod.Get))
                            {
                                @Html.Hidden("id", item.LoanId)
                                <button type="submit" class="btn btn-sm btn-primary mr-3">Редактировать</button>
                            }
                        </div>
                        <div class="mx-2">
                            @using (Html.BeginForm("Delete", "Loan", FormMethod.Post, new { id = item.LoanId }))
                            {
                                @Html.Hidden("id", item.LoanId)
                                <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                            }
                        </div>
                        <div class="mx-2">
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#loanOperationsModal_@item.LoanId">
                                Операции
                            </button>
                        </div>
                    </div>
                </td>
            </tr>
            
        }

    </tbody>
</table>
@*  Модальное окно  *@
@foreach (var item in Model)
{
    <div class="modal fade" id="loanOperationsModal_@item.LoanId" tabindex="-1" role="dialog" aria-labelledby="loanOperationsModalLabel_@item.LoanId" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loanOperationsModalLabel_@item.LoanId">Операции с займом № @item.LoanId</h5>
                   
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("ProcessLoanOperation", "Loan", FormMethod.Post))
                    {
                        @Html.Hidden("LoanId", item.LoanId)
                        <div class="form-group">
                            @Html.Label("OperationType", "Тип операции:")
                            @Html.DropDownList("OperationType", new SelectList(ViewBag.OperationTypes, "Value", "Text"), "Выберите тип операции", new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            @Html.Label("Amount", "Сумма:")
                            @Html.TextBox("Amount", null, new { @class = "form-control", type = "number", step = "0.01" })
                        </div>
                        <div class="form-group">
                            @Html.Label("TransactionDate", "Дата финансовой операции:")
                            @Html.TextBox("TransactionDate", null, new { @class = "form-control", type = "date" })
                        </div>
                        <div class="form-group">
                            @Html.Label("Description", "Описание:")
                            @Html.TextArea("Description", null, new { @class = "form-control", type = "text" })
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Выполнить</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}